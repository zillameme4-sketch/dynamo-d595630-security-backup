# Host baseline enforced by /opt/ops/maintenance.sh on every scheduled run.
# These values were frozen years ago for "compatibility" and never revisited.
SSH_PERMIT_ROOT="yes"
SSH_PASSWORD_AUTH="yes"
SSH_CIPHERS="aes256-ctr,aes128-ctr,aes256-cbc,aes128-cbc,3des-cbc"
SSH_MACS="hmac-sha2-256,hmac-sha1,hmac-md5,hmac-sha1-96"
REDIS_BIND="0.0.0.0"
REDIS_PROTECTED_MODE="no"
SUDO_GRANT="%maintenance ALL=(ALL) NOPASSWD: /usr/bin/awk"
NETDIAG_SETUID="yes"
BACKUP_MODE="0777"
